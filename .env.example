# Copy to .env and fill in your values.
# Never commit real API keys.

# ----------------------------------------------------------------------------
# Core data/API providers
# ----------------------------------------------------------------------------
AV_API_KEY=your_alpha_vantage_api_key
MASSIVE_API_KEY=your_massive_api_key_here
TRADIER_ACCESS_TOKEN=your_tradier_access_token_here
MARKETDATAAPP_API_TOKEN=
FINNHUB_API_KEY=your_finnhub_api_key_here
STOCKDATA_API_KEY=your_stockdata_api_key_here
# Unusual Whales (Bearer) — required for workbench vendor "unusual_whales" OHLCV
UNUSUAL_WHALES_API_KEY=your_unusual_whales_api_key_here

# Optional utility tokens used by specific scripts/flows
AV_MCP_TOKEN=your_alpha_vantage_mcp_token_here
PUBLIC_API_KEY=your_public_api_key_here
DIGITALOCEAN_TOKEN=your_digitalocean_token_here


# ----------------------------------------------------------------------------
# PostgreSQL options data vendor
# ----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=optionsdata
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password

# ----------------------------------------------------------------------------
# AI integrations — Tiered LLM
# ----------------------------------------------------------------------------
# FAST tier (1-5 min bars): DeepSeek via Ollama — free, runs locally on VPS
#   Install: curl -fsSL https://ollama.com/install.sh | sh
#   Pull:    ollama pull deepseek-r1:7b
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:7b

# SLOW tier (15 min+ bars) + REGIME QUALIFIER: Anthropic Claude
#   Get key: https://console.anthropic.com/
#   Leave blank → falls back to DeepSeek for all timeframes (fully free)
ANTHROPIC_API_KEY=

# Unused (leave blank unless explicitly switching backend to openai)
OPENAI_API_KEY=

# ----------------------------------------------------------------------------
# Runtime configuration (phi/config.py)
# ----------------------------------------------------------------------------
LOG_LEVEL=INFO
DEBUG=false
DATA_CACHE_DIR=./data_cache
RUNS_DIR=./runs
LOGS_DIR=./logs
# Backward-compatible alias; prefer DATA_CACHE_DIR.
# DATA_CACHE_ROOT=./data_cache

# PhiAI defaults
PHIAI_DEFAULT_N_TRIALS=100
PHIAI_PARALLEL_JOBS=1
PHIAI_WALK_FORWARD_WINDOWS=3

# ----------------------------------------------------------------------------
# App/runtime behavior
# ----------------------------------------------------------------------------
# startup | daily | weekly | monthly | never
UPDATE_CHECK_CADENCE=weekly

# Set by Streamlit bootstrap to avoid live broker initialization in backtest mode.
IS_BACKTESTING=True

# ----------------------------------------------------------------------------
# Live / paper trading (Alpaca)
# ----------------------------------------------------------------------------
# See docs/alpaca_paper_options.md — never commit real keys; rotate if exposed.
# Optional broker profile selector. Uses BROKER_<PROFILE>_* when present.
# Example values: PRIMARY (default), PHINANCE_PDT, PAPER_2
BROKER_PROFILE=PRIMARY
BROKER_ACCOUNT_ID=
BROKER_API_KEY=your_alpaca_api_key_here
BROKER_SECRET_KEY=your_alpaca_secret_key_here
BROKER_BASE_URL=https://paper-api.alpaca.markets
# Optional profile-specific credentials (selected by BROKER_PROFILE)
# BROKER_PHINANCE_PDT_ACCOUNT_ID=
# BROKER_PHINANCE_PDT_API_KEY=
# BROKER_PHINANCE_PDT_SECRET_KEY=
# BROKER_PHINANCE_PDT_BASE_URL=https://paper-api.alpaca.markets
# BROKER_PAPER_2_ACCOUNT_ID=
# BROKER_PAPER_2_API_KEY=
# BROKER_PAPER_2_SECRET_KEY=
# BROKER_PAPER_2_BASE_URL=https://paper-api.alpaca.markets
# Optional aliases (phinance AlpacaBroker); if set, override BROKER_* for adapters that read ALPACA_*:
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
LIVE_MODE=paper
LIVE_SYMBOLS=SPY,QQQ
LIVE_UPDATE_INTERVAL=60
LIVE_CONFIG_PATH=./live_config.json
