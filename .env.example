# Copy to .env and fill in your values.
# Never commit real API keys.

# ----------------------------------------------------------------------------
# Core data/API providers
# ----------------------------------------------------------------------------
AV_API_KEY=PLN25H3ESMM1IRBN
MASSIVE_API_KEY=your_massive_api_key_here
TRADIER_ACCESS_TOKEN=your_tradier_access_token_here
MARKETDATAAPP_API_TOKEN=
FINNHUB_API_KEY=your_finnhub_api_key_here
STOCKDATA_API_KEY=your_stockdata_api_key_here

# Optional utility tokens used by specific scripts/flows
AV_MCP_TOKEN=your_alpha_vantage_mcp_token_here
PUBLIC_API_KEY=your_public_api_key_here
DIGITALOCEAN_TOKEN=your_digitalocean_token_here

# ----------------------------------------------------------------------------
# AI integrations
# ----------------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ----------------------------------------------------------------------------
# Runtime configuration (phi/config.py)
# ----------------------------------------------------------------------------
LOG_LEVEL=INFO
DEBUG=false
DATA_CACHE_DIR=./data_cache
RUNS_DIR=./runs
LOGS_DIR=./logs
# Backward-compatible alias; prefer DATA_CACHE_DIR.
# DATA_CACHE_ROOT=./data_cache

# PhiAI defaults
PHIAI_DEFAULT_N_TRIALS=100
PHIAI_PARALLEL_JOBS=1
PHIAI_WALK_FORWARD_WINDOWS=3

# ----------------------------------------------------------------------------
# App/runtime behavior
# ----------------------------------------------------------------------------
# startup | daily | weekly | monthly | never
UPDATE_CHECK_CADENCE=weekly

# Set by Streamlit bootstrap to avoid live broker initialization in backtest mode.
IS_BACKTESTING=True

# ----------------------------------------------------------------------------
# Live trading
# ----------------------------------------------------------------------------
BROKER_API_KEY=your_alpaca_api_key_here
BROKER_SECRET_KEY=your_alpaca_secret_key_here
BROKER_BASE_URL=https://paper-api.alpaca.markets
LIVE_MODE=paper
LIVE_SYMBOLS=SPY,QQQ
LIVE_UPDATE_INTERVAL=60
LIVE_CONFIG_PATH=./live_config.json
